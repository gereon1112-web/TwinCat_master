<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_ExtruderControl" Id="{65a00b64-e984-4214-ae34-d95a406e080b}">
    <Declaration><![CDATA[TYPE ST_ExtruderControl :
STRUCT
	// Steuersignale
	bErrorReset 	: BOOL;						// Reset-Befehl für Fehler
	bStartHeater 	: BOOL;						// Heizelemente aktivieren
	bStopHeater		: BOOL;						// Abschalten und Abkühlen
	bStart 			: BOOL;						// Start-Befehl Extrusion
	bStop 			: BOOL;						// Stop-Befehl Extrusion
	
	// Statusinformationen
	bReady 			: BOOL;						// Betriebsbereit
	bExtruding 		: BOOL;						// Motor läuft
	bHeatingActiv 	: BOOL;						// Heizelemente
	bError 			: BOOL;						// Fehler
	nErrorID      	: UDINT;
    sErrorMsg 		: STRING(80);
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>