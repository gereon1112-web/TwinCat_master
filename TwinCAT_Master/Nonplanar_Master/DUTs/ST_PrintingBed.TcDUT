	bAtTemp			: BOOL;			// Solltemperatur erreicht (0.5°C Toleranz)
	bErrorReset		: BOOL;
	bError        	: BOOL;			// Fehler
    nErrorID      	: UDINT;
    sErrorMsg 		: STRING(80);
END_STRUCT
END_TYPE
]]></Declaration>
