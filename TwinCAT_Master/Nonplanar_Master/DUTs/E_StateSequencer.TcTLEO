(
	OFF					:= 0,
	INIT_1				:= 10,
	INIT_2				:= 11,
	INIT_3				:= 12,
	HOMING_1			:= 90,
	HOMING_2			:= 91,
	
	IDLE				:= 100,
	OPEN_FILE			:= 110,
	CLOSE_FILE			:= 120,
	CHANGE_MATERIAL_1	:= 130,
	CHANGE_MATERIAL_2	:= 131,
	CHANGE_MATERIAL_3	:= 132,
	
	READY				:= 200,
	
	PREP_PRINTING		:= 300,
	PREP_PRINTING_HEX_1	:= 301,
	PREP_PRINTING_HEX_2	:= 302,
	PREP_PRINTING_HEX_3	:= 303,
