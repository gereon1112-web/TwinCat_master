	WRITE_KOS			:= 330,
	WRITE_FEED			:= 331,
	WRITE_PROG			:= 335,
	
	EXTRUDER_ON_1		:= 340,
	EXTRUDER_ON_2		:= 341,
	
	EXTRUDER_OFF_1		:= 350,
	START_EXTRUDING		:= 351,
